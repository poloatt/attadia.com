{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        },
        {
          "key": "Cache-Control",
          "value": "private, no-store"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/atta",
      "destination": "https://www.attadia.com/atta"
    },
    {
      "source": "/atta/:path*",
      "destination": "https://www.attadia.com/atta/:path*"
    }
  ]
}
